{
  "output": {
    "params": {
      "value": {
        "instance_id": "${aws_instance.node.id}",
        "ip": "${aws_instance.node.public_ip}",
        "name": "${aws_instance.node.tags[\"Name\"]}",
        "node_id": "metabase-0",
        "provider": "aws",
        "provider_id": "${aws_instance.node.id}",
        "ssh_key_id": 12345,
        "sudoer": "ubuntu",
        "user": "ubuntu",
        "vpc_ip": "${aws_instance.node.private_ip}"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1"
    }
  },
  "resource": {
    "aws_instance": {
      "node": {
        "ami": "ami-025d99823a4caad37",
        "associate_public_ip_address": true,
        "availability_zone": "us-east-1a",
        "instance_type": "t3.medium",
        "key_name": "example",
        "lifecycle": {
          "prevent_destroy": true
        },
        "root_block_device": {
          "encrypted": true,
          "volume_size": 60,
          "volume_type": "gp3"
        },
        "subnet_id": "subnet-0123456789abcdef0",
        "tags": {
          "Name": "clickhouse-fixture-metabase-0"
        },
        "vpc_security_group_ids": [
          "build-firewall-metabase"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "6.31.0"
      }
    },
    "required_version": ">= 1.8.0"
  }
}
